<Project>

  <!--
    Copy this file to Directory.Build.local.props (same folder) and point the two properties at
    your own SPT installs. That copy is gitignored: these are machine paths and never committed.

    They are SEPARATE properties on purpose. Building both stubs on one machine means having both
    installs on hand, and pointing one variable at each in turn is exactly how a 4.1 assembly ends
    up referenced by the 4.0 build without anyone noticing until runtime.

    Either property can also be supplied as an environment variable (SPT_SERVER_DIR /
    SPT_SERVER_40_DIR) or on the command line with -p:SptServerDir="..." instead of using this file.
  -->
  <PropertyGroup>

    <!-- SPT 4.1.x - the folder holding SPT.Server.exe. Used by ServerMap.Server.Stub. -->
    <SptServerDir>G:\Single Player Tarkov 4.1\SPT_Runtime</SptServerDir>

    <!-- SPT 4.0.13 - the folder holding SPT.Server.exe. Used by ServerMap.Server.Stub.Spt40. -->
    <Spt40ServerDir>D:\Single Player Tarkov Server\SPT</Spt40ServerDir>

  </PropertyGroup>

</Project>
